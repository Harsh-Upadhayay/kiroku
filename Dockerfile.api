FROM golang:1.22-alpine AS build

WORKDIR /src

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend ./
RUN CGO_ENABLED=0 go build -o /out/kiroku-api ./cmd/kiroku-api

# ── CI stage: Go unit tests ──────────────────────────────────────────────────
FROM golang:1.22-alpine AS ci

WORKDIR /src

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend ./

# Run all tests; exit non-zero if any intentionally-passing tests fail.
# BUG-15 test is expected to fail (documents a known bug); skip it here if needed
# by tagging it, or accept the failure and handle it in CI pipeline logic.
RUN go test ./... 2>&1 | tee /tmp/test-results.txt; \
    # Allow failure from known-bug tests (BUG-15) but fail on unexpected failures
    # Remove this grep exclusion once BUG-15 is fixed.
    FAIL_COUNT=$(grep -c "^--- FAIL" /tmp/test-results.txt || true); \
    BUG_FAIL=$(grep -c "BUG-15" /tmp/test-results.txt || true); \
    if [ "$FAIL_COUNT" -gt "$BUG_FAIL" ]; then exit 1; fi

# ── Production runtime: minimal static binary ────────────────────────────────
FROM alpine:3.20 AS runtime

WORKDIR /app
ENV PORT=8080
ENV DATA_DIR=/app/data

COPY --from=build /out/kiroku-api /app/kiroku-api

RUN apk add --no-cache \
      tesseract-ocr \
      tesseract-ocr-data-eng \
      tesseract-ocr-data-jpn \
    && mkdir -p /app/data \
    && addgroup -g 1000 appgroup \
    && adduser -D -H -u 1000 -G appgroup appuser \
    && chown -R appuser:appgroup /app

USER appuser
EXPOSE 8080

CMD ["/app/kiroku-api"]

# -- Dev stage: compiles from mounted source on every start -----------------
# Used only by dev-deploy/ in-cluster; CI never builds this target.
#
# go mod download IS kept (unlike the frontend's npm ci): it populates
# /go/pkg/mod, which sits outside /src and so survives the workspace mount.
#
# GOCACHE: the Deployment runs as uid 1000, but this base image never creates
# that user or a home for it, so Go's default $HOME/.cache/go-build is
# unwritable -- `mkdir /.cache: permission denied` on start. /tmp is writable
# by anyone. alpine is fine here: Go builds static, no libc coupling.
#
# No watcher (air etc.) by choice -- pick up backend edits with
# `kubectl rollout restart deploy/kiroku-api`.
FROM golang:1.22-alpine AS dev
WORKDIR /src
ENV GOCACHE=/tmp/go-cache
COPY backend/go.mod backend/go.sum ./
RUN go mod download
CMD ["go", "run", "./cmd/kiroku-api"]