# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional local Ollama vision import. Leave URL blank to use Tesseract OCR only.
VOCAB_OLLAMA_URL=""
VOCAB_OLLAMA_MODEL="qwen2.5vl:3b"
VOCAB_OLLAMA_TIMEOUT_SECONDS="240"
VOCAB_OCR_BINARY="tesseract"
VOCAB_OCR_LANGUAGES="jpn+eng"
VOCAB_OCR_PSM="6"
VOCAB_OCR_TIMEOUT_SECONDS="90"
